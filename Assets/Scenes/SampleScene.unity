  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041A\u043E\u0441\u0442\u0440\u043E\u043C\u0430 \u2014 \u043E\u0434\u0438\u043D
    \u0438\u0437 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445 \u0433\u043E\u0440\u043E\u0434\u043E\u0432
    \u0442\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \xAB\u0417\u043E\u043B\u043E\u0442\u043E\u0435
    \u043A\u043E\u043B\u044C\u0446\u043E \u0420\u043E\u0441\u0441\u0438\u0438\xBB.
    \u0415\u0451 \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0438 \u0432 \u0441\u043F\u0438\u0441\u043E\u043A
    \u043B\u0438\u0447\u043D\u043E \u043F\u043E \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435
    \u042E\u0440\u0438\u044F \u0411\u044B\u0447\u043A\u043E\u0432\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0438 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B \u044D\u0442\u043E\u0442
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0432 1960-\u0435 \u0433\u043E\u0434\u044B.
    \u0413\u043E\u0440\u043E\u0434 \u0446\u0435\u043D\u044F\u0442 \u0437\u0430 \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u0443\u044E
    \u0438\u0441\u0442\u043E\u0440\u0438\u044E, \u0431\u043E\u0433\u0430\u0442\u043E\u0435
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435
    \u0438 \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u043D\u044B\u0435 \u0432\u0438\u0434\u044B
    \u043D\u0430 \u0412\u043E\u043B\u0433\u0443. "
